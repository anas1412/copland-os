#!/usr/bin/env bash
# copland-layers: choose which apps open on which Layer (workspace).
# Writes ~/.config/copland-os/layers.conf, which the devilspie2 rules read.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/copland-os/layers.conf"
[ -t 0 ] && [ -t 1 ] || { echo "copland-layers needs a terminal."; exit 1; }

CY=$'\e[38;2;70;186;239m'; BL=$'\e[38;2;25;122;186m'; TX=$'\e[38;2;204;221;255m'
DM=$'\e[38;2;90;108;170m'; GN=$'\e[38;2;95;215;167m'; YL=$'\e[38;2;230;210;138m'
HL=$'\e[48;2;22;40;92m'; B=$'\e[1m'; R=$'\e[0m'

NAME=(); KEY=(); LAYER=()
declare -A SEEN
FOLLOW=true; DEFAULT=0; DIRTY=0

NL="$(xfconf-query -c xfwm4 -p /general/workspace_count 2>/dev/null || echo 4)"
case "$NL" in ''|*[!0-9]*) NL=4 ;; esac
[ "$NL" -gt 9 ] && NL=9
WSNAMES=()
while IFS= read -r l; do WSNAMES+=("$l"); done < <(xfconf-query -c xfwm4 -p /general/workspace_names 2>/dev/null | tail -n +3 || true)

add() {  # add <name> <key>
    local name=$1 key=${2,,}
    [ -n "$key" ] || return 0
    [ -z "${SEEN[$key]:-}" ] || return 0
    SEEN[$key]=${#NAME[@]}
    NAME+=("$name"); KEY+=("$key"); LAYER+=(0)
}

load_desktop() {
    local f line name cls ex nodisp type cats insec key list=""
    for f in /usr/share/applications/*.desktop "$HOME/.local/share/applications"/*.desktop; do
        [ -r "$f" ] || continue
        name=""; cls=""; ex=""; nodisp=""; type=""; cats=""; insec=0
        while IFS= read -r line; do
            case "$line" in
                "[Desktop Entry]") insec=1 ;;
                "["*) if [ "$insec" -eq 1 ]; then break; fi ;;
                Name=*) if [ -z "$name" ]; then name=${line#Name=}; fi ;;
                StartupWMClass=*) cls=${line#StartupWMClass=} ;;
                Exec=*) if [ -z "$ex" ]; then ex=${line#Exec=}; fi ;;
                NoDisplay=*) nodisp=${line#NoDisplay=} ;;
                Type=*) type=${line#Type=} ;;
                Categories=*) cats=${line#Categories=} ;;
            esac
        done < "$f"
        [ "$type" = "Application" ] || continue
        [ "$nodisp" != "true" ] || continue
        case ";$cats" in *";Settings;"*) continue ;; esac
        if [ -n "$cls" ]; then
            key=$cls
        else
            # no declared window class: the .desktop file name is the usual one
            key=${f##*/}; key=${key%.desktop}
        fi
        [ -n "$name" ] || name=$key
        list+="$name"$'\t'"$key"$'\n'
    done
    while IFS=$'\t' read -r name key; do
        [ -n "$name" ] && add "$name" "$key"
    done < <(printf '%s' "$list" | sort -f -u)
}

load_windows() {
    command -v xprop >/dev/null || return 0
    local w out inst cls
    for w in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -oE '0x[0-9a-f]+' || true); do
        out="$(xprop -id "$w" WM_CLASS 2>/dev/null || true)"
        inst="$(printf '%s' "$out" | sed -n 's/.*= "\([^"]*\)", "\([^"]*\)".*/\1/p')"
        cls="$(printf '%s' "$out" | sed -n 's/.*= "\([^"]*\)", "\([^"]*\)".*/\2/p')"
        case "${inst,,}" in ""|xfdesktop|xfce4-panel|wrapper-2.0) continue ;; esac
        # skip if an app from the menu already covers this window
        local k hit=0
        for k in "${KEY[@]}"; do
            case "${inst,,} ${cls,,}" in *"$k"*) hit=1; break ;; esac
        done
        [ "$hit" -eq 1 ] || add "$cls (open now)" "$inst"
    done
}

load_conf() {
    local src="$CONF"
    # start from the system default (installed with --system) until the user saves their own
    [ -r "$src" ] || src=/etc/copland-os/layers.conf
    [ -r "$src" ] || return 0
    local line k v
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        k="${line%%=*}"; v="${line#*=}"
        k="${k#"${k%%[![:space:]]*}"}"; k="${k%"${k##*[![:space:]]}"}"
        v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
        case "$k" in
            follow) FOLLOW=$v ;;
            default) case "$v" in [0-9]) DEFAULT=$v ;; esac ;;
            *)  case "$v" in [1-9]) ;; *) continue ;; esac
                k=${k,,}
                [ -n "${SEEN[$k]:-}" ] || add "$k (custom rule)" "$k"
                LAYER[${SEEN[$k]}]=$v ;;
        esac
    done < "$src"
}

lname() {  # layer number -> label
    local n=$1
    if [ "$n" -eq 0 ]; then printf 'anywhere'; else printf '%s' "${WSNAMES[$((n - 1))]:-Layer $n}"; fi
}

save() {
    mkdir -p "$(dirname "$CONF")"
    {
        echo "# Copland OS layers. Edit with: copland-layers"
        echo "# <part of the app's window class> = <layer number>"
        echo "follow = $FOLLOW"
        echo "default = $DEFAULT"
        local i
        for i in "${!KEY[@]}"; do
            [ "${LAYER[$i]}" -gt 0 ] && echo "${KEY[$i]} = ${LAYER[$i]}"
        done
        true
    } > "$CONF.tmp"
    mv "$CONF.tmp" "$CONF"
    DIRTY=0
    # devilspie2 only re-reads its .lua files, so restart it to pick up the new choices
    if command -v devilspie2 >/dev/null; then
        pkill -u "$EUID" -x devilspie2 2>/dev/null || true
        local v drop=()
        for v in $(compgen -e); do case "$v" in CLAUDE*|ANTHROPIC*) drop+=(-u "$v") ;; esac; done
        ( cd "$HOME" && env "${drop[@]}" setsid -f devilspie2 >/dev/null 2>&1 ) || true
    fi
}

draw() {
    local cur=$1 top=$2 view=$3 n=${#NAME[@]} i badge row count=0
    for i in "${!LAYER[@]}"; do [ "${LAYER[$i]}" -gt 0 ] && count=$((count + 1)); done
    printf '\e[H\e[2J'
    printf '\n  %s%s◉  C O P L A N D   O S%s  %s·  L A Y E R S%s\n' "$B" "$CY" "$R" "$TX" "$R"
    printf '  %sChoose the layer each app opens on. Apps left on "anywhere" open where you are.%s\n\n' "$DM" "$R"
    printf '  %sLayers:%s' "$DM" "$R"
    for ((i = 1; i <= NL; i++)); do printf '  %s%s%s %s' "$CY" "$i" "$R" "$(lname "$i")"; done
    printf '\n  %sEverything else:%s %s%s%s    %sSwitch to the layer when an app opens:%s %s%s%s    %s%s assigned%s\n' \
        "$DM" "$R" "$TX" "$(lname "$DEFAULT")" "$R" "$DM" "$R" "$TX" "$([ "$FOLLOW" = true ] && echo yes || echo no)" "$R" "$DM" "$count" "$R"
    printf '  %s──────────────────────────────────────────────────────────────────────────%s\n' "$BL" "$R"
    for ((i = top; i < top + view && i < n; i++)); do
        if [ "${LAYER[$i]}" -gt 0 ]; then badge="${CY}${B}$(printf '%-10s' "$(lname "${LAYER[$i]}")")${R}"
        else badge="${DM}·         ${R}"; fi
        if [ "$i" -eq "$cur" ]; then
            row="${HL}${CY}${B} ▸ ${R}${HL} ${badge}${HL} ${TX}${B}$(printf '%-36.36s' "${NAME[$i]}")${R}${HL} ${DM}$(printf '%-22.22s' "${KEY[$i]}")${R}"
        else
            row="    ${badge} ${TX}$(printf '%-36.36s' "${NAME[$i]}")${R} ${DM}$(printf '%-22.22s' "${KEY[$i]}")${R}"
        fi
        printf '  %s\n' "$row"
    done
    printf '  %s──────────────────────────────────────────────────────────────────────────%s\n' "$BL" "$R"
    printf '  %s%d–%d of %d%s%s\n' "$DM" "$((top + 1))" "$((top + view < n ? top + view : n))" "$n" "$([ "$DIRTY" -eq 1 ] && printf '   %s● unsaved changes' "$YL")" "$R"
    printf '  %s↑ ↓%s move  %s1–%s%s set layer  %s0%s anywhere  %sd%s everything else  %sf%s follow  %ss%s save  %sq%s quit\n' \
        "$CY" "$DM" "$CY" "$NL" "$DM" "$CY" "$DM" "$CY" "$DM" "$CY" "$DM" "$CY" "$DM" "$CY" "$R"
}

main() {
    load_desktop; load_windows; load_conf
    [ "${#NAME[@]}" -gt 0 ] || { echo "No apps found."; exit 1; }
    local cur=0 top=0 n=${#NAME[@]} key rest rows view
    trap 'printf "\e[?25h\e[0m"' EXIT
    printf '\e[?25l'
    while :; do
        rows="$(stty size 2>/dev/null | cut -d' ' -f1)"; case "$rows" in ''|*[!0-9]*) rows=24 ;; esac
        view=$((rows - 11)); [ "$view" -lt 3 ] && view=3
        [ "$cur" -lt "$top" ] && top=$cur
        [ "$cur" -ge $((top + view)) ] && top=$((cur - view + 1))
        draw "$cur" "$top" "$view"
        IFS= read -rsn1 key || key=q
        case "$key" in
            $'\e')
                rest=""; IFS= read -rsn2 -t 0.05 rest || true
                case "$rest" in
                    '[A') cur=$(( cur > 0 ? cur - 1 : n - 1 )) ;;
                    '[B') cur=$(( cur < n - 1 ? cur + 1 : 0 )) ;;
                    '[5') IFS= read -rsn1 -t 0.05 rest || true; cur=$(( cur - view > 0 ? cur - view : 0 )) ;;
                    '[6') IFS= read -rsn1 -t 0.05 rest || true; cur=$(( cur + view < n - 1 ? cur + view : n - 1 )) ;;
                esac ;;
            k) cur=$(( cur > 0 ? cur - 1 : n - 1 )) ;;
            j) cur=$(( cur < n - 1 ? cur + 1 : 0 )) ;;
            [0-9]) if [ "$key" -le "$NL" ]; then LAYER[$cur]=$key; DIRTY=1; cur=$(( cur < n - 1 ? cur + 1 : cur )); fi ;;
            d) DEFAULT=$(( (DEFAULT + 1) % (NL + 1) )); DIRTY=1 ;;
            f) if [ "$FOLLOW" = true ]; then FOLLOW=false; else FOLLOW=true; fi; DIRTY=1 ;;
            s|'') save; printf '\e[?25h\e[H\e[2J\n  %s✔ Saved.%s New windows follow your choices from now on.\n  %s%s%s\n\n' "$GN" "$R" "$DM" "$CONF" "$R"; exit 0 ;;
            q) printf '\e[?25h\e[H\e[2J'; [ "$DIRTY" -eq 1 ] && echo "  Nothing saved."; exit 0 ;;
        esac
    done
}

main "$@"
