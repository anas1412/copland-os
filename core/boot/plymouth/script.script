# Copland OS boot animation (frames from faisalhsn/copland-plymouth-theme).
# Scales every frame to cover the whole screen, keeping its shape, so there
# are no black bars on any resolution. Frames are loaded one at a time, so
# only the frame on screen is held in memory.

# frame edge colour (#171a31), shown if a screen shape ever leaves a gap
Window.SetBackgroundTopColor(0.090, 0.102, 0.192);
Window.SetBackgroundBottomColor(0.090, 0.102, 0.192);

global.nframes = 25;
global.nseconds = 8.333333;

first = Image("progress-1.png");
scale_w = Window.GetWidth() / first.GetWidth();
scale_h = Window.GetHeight() / first.GetHeight();
if (scale_w > scale_h) scale = scale_w; else scale = scale_h;
global.w = Math.Int(first.GetWidth() * scale + 0.5);
global.h = Math.Int(first.GetHeight() * scale + 0.5);

global.video = Sprite();
global.video.SetX(Window.GetX() + Window.GetWidth() / 2 - global.w / 2);
global.video.SetY(Window.GetY() + Window.GetHeight() / 2 - global.h / 2);
global.video.SetImage(first.Scale(global.w, global.h));

global.shown = 1;
global.progress = 1;

fun refresh_callback () {
    if (Math.Int(global.progress) <= global.nframes) {
        n = Math.Int(global.progress);
        if (n != global.shown) {
            global.video.SetImage(Image("progress-" + n + ".png").Scale(global.w, global.h));
            global.shown = n;
        }
        global.progress = global.progress + ((global.nframes / global.nseconds) / 50);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- messages and prompts -------------------------------------------------------
# Debian's tools talk to the user through the boot screen: the live session's "remove
# the live-medium and press ENTER" at shutdown, the disk-encryption password at boot,
# fsck notes. A theme that does not draw them leaves the screen waiting with nothing
# shown. Text only (no image files): palette text #ccddff, cyan #46baef, white.
# Below the animation's own progress bar (74-78 % of the height): prompt at 83 %,
# what is typed at 88 %, other messages at 93 %.
# Calls as in Plymouth 24.004's own sample theme (themes/script/script.script).

global.message = Sprite();
global.prompt = Sprite();
global.entry = Sprite();

fun place_text (sprite, text, y, r, g, b) {
    local.img = Image.Text(text, r, g, b, 1, "DejaVu Sans 15");
    sprite.SetImage(local.img);
    sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - local.img.GetWidth() / 2, y, 10000);
    sprite.SetOpacity(1);
}

fun display_message_callback (text) {
    place_text(global.message, text, Window.GetY() + Window.GetHeight() * 0.93, 0.80, 0.867, 1);
}

fun hide_message_callback (text) {
    global.message.SetOpacity(0);
}

# the password itself is never shown: one * per typed character
fun display_password_callback (prompt, bullets) {
    place_text(global.prompt, prompt, Window.GetY() + Window.GetHeight() * 0.83, 0.275, 0.729, 0.937);
    local.stars = "";
    for (local.i = 0; local.i < bullets; local.i++)
        local.stars = local.stars + "* ";
    place_text(global.entry, local.stars + "_", Window.GetY() + Window.GetHeight() * 0.88, 1, 1, 1);
}

fun display_question_callback (prompt, entry) {
    place_text(global.prompt, prompt, Window.GetY() + Window.GetHeight() * 0.83, 0.275, 0.729, 0.937);
    place_text(global.entry, entry + "_", Window.GetY() + Window.GetHeight() * 0.88, 1, 1, 1);
}

fun display_normal_callback () {
    global.prompt.SetOpacity(0);
    global.entry.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
