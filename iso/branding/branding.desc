# Copland OS branding for the Calamares installer on CoplandOS.iso.
# Based on Debian's calamares-settings-debian branding. @COPLAND_VERSION@ and @DEBIAN_VERSION@ are filled in by
# iso/build.sh from iso/release.conf.
---
componentName:   copland
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,580px
windowPlacement: center
strings:
    productName:         Copland OS Enterprise
    shortProductName:    Copland OS
    version:             @COPLAND_VERSION@
    shortVersion:        @COPLAND_VERSION@
    versionedName:       Copland OS Enterprise @COPLAND_VERSION@ (Debian @DEBIAN_VERSION@)
    shortVersionedName:  Copland OS @COPLAND_VERSION@
    bootloaderEntryName: Copland OS Enterprise
    productUrl:          https://github.com/anas1412/copland-os
    supportUrl:          https://github.com/anas1412/copland-os/issues
    knownIssuesUrl:      https://github.com/anas1412/copland-os/issues
    releaseNotesUrl:     https://github.com/anas1412/copland-os#readme
    donateUrl:           https://www.debian.org/donations
sidebar: widget
navigation: widget
images:
    productLogo:         "copland-logo.png"
    productIcon:         "copland-logo.png"
    productWelcome:      "welcome.png"
slideshow:               "show.qml"
style:
   SidebarBackground:    "#101838"
   SidebarText:          "#ccddff"
   SidebarTextCurrent:   "#ffffff"
   SidebarBackgroundCurrent: "#197aba"
slideshowAPI: 2
