#!/bin/sh
# Copland OS: brand the Calamares installer. Only the live image has Calamares (the
# installer removes it from the installed system), so this lives in iso/, not --system.
# Debian's settings and launcher are diverted, not edited, so the packages stay intact.
set -e

B=/etc/calamares/branding/copland
S=/usr/share/copland-os/iso-branding
C=/usr/share/copland-os/iso-calamares
install -d -m 755 "$B"
install -m 644 "$S/branding.desc" "$S/show.qml" "$S/copland-logo.png" "$S/welcome.png" "$S"/slide-*.png \
    "$S"/choose-*.png "$B/"

# the Apps and Developer tools pages, and the job that installs what was ticked there
install -m 644 "$C/packagechooser-apps.conf" "$C/packagechooser-dev.conf" /etc/calamares/modules/
install -d -m 755 /usr/lib/calamares/modules/copland-extras
install -m 644 "$C/modules/copland-extras/module.desc" "$C/modules/copland-extras/main.py" \
    /usr/lib/calamares/modules/copland-extras/

# settings.conf: Debian's, with our branding, the two pages and the job (patch-settings.py)
dpkg-divert --local --rename --divert /etc/calamares/settings.conf.debian --add /etc/calamares/settings.conf
python3 "$C/patch-settings.py" /etc/calamares/settings.conf.debian /etc/calamares/settings.conf
grep -q '^branding: copland$' /etc/calamares/settings.conf
grep -q '^  - copland-extras$' /etc/calamares/settings.conf

# the launcher (also copied to the live desktop by add-calamares-desktop-icon)
L=/usr/share/applications/calamares-install-debian.desktop
dpkg-divert --local --rename --divert "$L.debian" --add "$L"
sed -e 's/^Name=.*/Name=Install Copland OS/' \
    -e 's/^Comment=.*/Comment=Install Copland OS Enterprise @COPLAND_VERSION@ (Debian @DEBIAN_VERSION@) to this computer/' \
    -e 's|^Icon=.*|Icon=/usr/share/themes/CoplandOS/assets/copland-logo-128.png|' \
    "$L.debian" > "$L"

rm -rf "$S" "$C"
