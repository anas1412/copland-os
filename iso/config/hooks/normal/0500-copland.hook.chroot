#!/bin/sh
# Copland OS is in the image as the copland-os-desktop package (iso/build.sh put it in
# config/packages.chroot, and live-build installed it with apt), so dpkg owns its files
# and installed systems update it with apt.
#
# Its install script runs once more here, after every package is in: plymouth and
# console-setup are only Recommends, so apt may have set them up after it, and then the
# boot animation and the console font would not be set. Every step in it is safe to
# repeat. live-build rebuilds the initramfs after the hooks, and Calamares writes GRUB at
# install time.
set -e

/var/lib/dpkg/info/copland-os-desktop.postinst configure

# the boot animation must be the default, or the image boots with Debian's
[ "$(/usr/sbin/plymouth-set-default-theme)" = copland ]
