#!/bin/sh
# CoplandOS.iso: live-build configuration (written for live-build 1:20250505).
# Called by "lb config"; iso/build.sh runs it inside its work folder, next to a copy of
# iso/release.conf, which names the Debian release.
set -e

. ./release.conf

lb config noauto \
    --mode debian \
    --distribution "$DEBIAN_CODENAME" \
    --architecture amd64 \
    --archive-areas "main contrib non-free-firmware" \
    --security true \
    --updates true \
    --binary-image iso-hybrid \
    --bootloaders "syslinux,grub-efi" \
    --debian-installer none \
    --firmware-chroot true \
    --firmware-binary false \
    --apt-recommends true \
    --image-name CoplandOS \
    --iso-volume "COPLANDOS" \
    --iso-application "Copland OS Enterprise" \
    --iso-publisher "Copland OS fan project" \
    --bootappend-live "boot=live components quiet splash username=lain hostname=coplandos" \
    "${@}"
